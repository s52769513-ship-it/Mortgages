# Postgres connection string. On Railway, reference the database service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:pass@localhost:5432/mortgages"

# Signs the session tokens. At least 32 random characters — the server refuses
# to start in production with anything shorter or with this placeholder.
# Changing it logs everyone out.
JWT_SECRET="change-me-in-production"

PORT=4000

# Where uploaded files and voice notes are written. On Railway this MUST point
# at a mounted volume — a container's own filesystem is wiped on every deploy.
UPLOAD_DIR="./uploads"

# Creates the first administrator on an empty install, then does nothing.
# Remove both once you have signed in and changed the password.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="מנהל המערכת"

# Only used in development, where the client runs on its own port. In production
# the server serves the built client from the same origin and this is ignored.
CLIENT_ORIGIN="http://localhost:5173"
