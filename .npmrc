# The build needs the devDependencies: the type checker's @types/react, vite,
# tailwind and postcss are all build-time tools, and the deploy host sets
# NODE_ENV=production, which by itself makes "npm ci" skip every one of them.
#
# Without this the install quietly succeeds with 182 packages instead of 314
# and the build then fails on a wall of "Could not find a declaration file for
# module 'react'" — a failure that never reproduces locally, because nothing
# sets NODE_ENV there.
include=dev
